{
  "name": "@hnode/tidy",
  "version": "0.20.2",
  "description": "Window tiling for GNOME and macOS with a layout picker, custom shortcuts and multi-monitor support",
  "type": "module",
  "bin": {
    "tidy": "bin/tidy.js"
  },
  "files": [
    "bin/tidy.js",
    "desktop/*.js",
    "desktop/*.cjs",
    "desktop/*.html",
    "desktop/*.css",
    "desktop/package.json",
    "desktop/package-lock.json",
    "desktop/native/*.swift",
    "lib/layouts.js",
    "lib/i18nCore.js",
    "lib/translations.json",
    "metadata.json",
    "scripts/manage.py",
    "scripts/i18n.py",
    "scripts/recover.js",
    "dist/tidy@hnode.dev.shell-extension.zip",
    "docs/README.en.md",
    "docs/DEVELOPMENT.md",
    "docs/MACOS.md",
    "docs/RELEASING.md",
    "docs/preview.png",
    "docs/assist-preview.png",
    "LICENSE",
    "NOTICE"
  ],
  "os": ["linux", "darwin"],
  "engines": {
    "node": ">=18"
  },
  "keywords": ["gnome", "ubuntu", "macos", "tiling", "window-manager", "snap-layouts", "multi-monitor"],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "test": "node scripts/test.js",
    "check": "node scripts/check.js",
    "test:shell": "python3 scripts/test-shell.py",
    "build": "node scripts/build.js",
    "prepack": "node scripts/build.js",
    "test:package": "node tests/npm-package-smoke.js",
    "test:desktop-ui": "node desktop/node_modules/electron/cli.js tests/desktop-ui-smoke.cjs",
    "install-extension": "python3 scripts/manage.py install",
    "uninstall-extension": "python3 scripts/manage.py uninstall"
  },
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hojin-v/Tidy.git"
  },
  "homepage": "https://github.com/hojin-v/Tidy#readme",
  "bugs": {
    "url": "https://github.com/hojin-v/Tidy/issues"
  }
}
